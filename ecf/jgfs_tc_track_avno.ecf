#!/bin/bash
#PBS -N gfs_tc_track_avno_00
#PBS -j oe
#PBS -A ENSTRACK-DEV
#PBS -q dev
#PBS -S /bin/bash
#PBS -l place=vscatter,select=3:ncpus=11:mpiprocs=11:mem=100GB
#PBS -l walltime=00:30:00
#PBS -l debug=true

set -x

export target=wcoss2
export model=ens_tracker
export cyc=12
export envir=dev
export job=gfs_avno_${cyc}
export PACKAGEROOT=/lfs/h2/emc/ens/noscrub/hananeh.jafary
export COMROOT=/lfs/h2/emc/ptmp/hananeh.jafary/$envir/com
export DATAROOT=/lfs/h2/emc/ptmp/hananeh.jafary

# versions file for tracker $tracker.ver
VERSION_FILE=${PACKAGEROOT}/versions/tracker.ver
if [ -f $VERSION_FILE ]; then
  . $VERSION_FILE
else
  ecflow_client --abort
  exit
fi
module reset
module use /lfs/h2/emc/ens/noscrub/hananeh.jafary/TC_tracker/modulefiles
module load ${target}.lua
module list
export KEEPDATA=YES

# CALL executable job script here
${PACKAGEROOT}/TC_tracker/jobs/JGFS_TC_TRACK_AVNO

#%include <tail.h>
#%manual
######################################################################
##PURPOSE:  Executes the job that creates GFS TC track forecasts
#######################################################################
%end


#!/bin/ksh --login

#SBATCH --job-name=gfs_tc_genesis
#SBATCH --account=fv3-cpu
#SBATCH --qos=batch
#SBATCH --ntasks=1

##SBATCH --nodes=66
##SBATCH --tasks-per-node=20
##SBATCH --cpus-per-task=2

#SBATCH --time=00:40:00
#SBATCH --mem=10g
#SBATCH -o gfs_tc_genesis.log

##%include <head.h>
##%include <envir-p2.h>

module reset
export target=ursa
module use /scratch4/HFIP/hwrfv3/noscrub/Hana.Jafary/TC_tracker/modulefiles
module load ${target}.lua
module list

set -x
export envir=dev
export cyc=12
export job=gfs_genesis_${cyc}

export PACKAGEROOT=/scratch4/HFIP/hwrfv3/noscrub/Hana.Jafary
export DATAROOT=/scratch4/HFIP/hwrfv3/noscrub/Hana.Jafary
export COMROOT=${DATAROOT}/com
export KEEPDATA=YES

# versions file for tracker $tracker.ver
#VERSION_FILE=${PACKAGEROOT}/tracker_version/version.ver
#if [ -f $VERSION_FILE ]; then
#  . $VERSION_FILE
#else
#  ecflow_client --abort
#  exit
#fi

# CALL executable job script here
${PACKAGEROOT}/TC_tracker/jobs/JGFS_TC_GENESIS

if [ $? -ne 0 ]; then
  ecflow_client --abort
  exit
fi

